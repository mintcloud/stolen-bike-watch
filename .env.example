# Pick a sink. `stdout` needs nothing else and is the right default for a
# first run; see notify.py.
NOTIFY_BACKEND=stdout

# NOTIFY_BACKEND=telegram
TELEGRAM_TOKEN=
TELEGRAM_USER_ID=

# NOTIFY_BACKEND=webhook
NOTIFY_WEBHOOK_URL=

# Only needed for the recognition pass (vlm.py). Without it the pipeline
# still runs and ranks on CLIP attributes alone -- it just gets noisier.
ANTHROPIC_API_KEY=
